# Self-hosted Supabase for ArkOS: the stack ark actually runs.
#
#   cp supabase/.env.example supabase/.env   # fill in every blank
#   docker compose -f supabase/compose.yaml --env-file supabase/.env up -d
#
# This is NOT the supabase-* services in the root docker-compose.yml; those are
# older (Postgres 15, no API gateway) and nothing on ark uses them.
#
# The app reaches this stack through the gateway on 127.0.0.1:18000, so in the
# root .env: SUPABASE_URL=http://127.0.0.1:18000 and the keys below.
#
# Generate the JWT secret and the keys signed with it as described in
# https://supabase.com/docs/guides/self-hosting/docker#securing-your-services
# Every blank below is a secret. supabase/.env is gitignored; keep it that way.

############
# Secrets
############
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
DASHBOARD_USERNAME=arkos
DASHBOARD_PASSWORD=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

############
# URLs
############
# Must be the address people actually reach, or links in auth emails and
# redirects point at localhost.
SUPABASE_PUBLIC_URL=http://localhost:18000
API_EXTERNAL_URL=http://localhost:18000/auth/v1
SITE_URL=http://localhost:1121/app/
ADDITIONAL_REDIRECT_URLS=http://localhost:1121/app/

############
# Database
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
PGRST_DB_SCHEMAS=public,storage
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# Auth
############
JWT_EXPIRY=3600
ENABLE_EMAIL_SIGNUP=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# Email verification. On a dev server it proves nothing, so:
#   ENABLE_EMAIL_AUTOCONFIRM=true  -> sign-up returns a session immediately;
#                                     the frontend already handles that.
#   DISABLE_SIGNUP=true            -> once everyone who needs an account has
#                                     one. Add people later with the admin API
#                                     (POST /auth/v1/admin/users, service key,
#                                     "email_confirm": true).
# To test the email flows instead, set ENABLE_EMAIL_AUTOCONFIRM=false: every
# email lands in the mailpit inbox at http://127.0.0.1:18025, never a real one.
ENABLE_EMAIL_AUTOCONFIRM=true
DISABLE_SIGNUP=false

MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# mailpit by default. For real delivery, a provider's SMTP credentials.
SMTP_ADMIN_EMAIL=arkos@localhost
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Arkos local

############
# Storage
############
GLOBAL_S3_BUCKET=stub
REGION=local
STORAGE_TENANT_ID=stub
