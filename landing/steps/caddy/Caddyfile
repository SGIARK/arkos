# /etc/caddy/Caddyfile  (or a site file imported by it)
#
# Public launch config for ark.mit.edu:
#   * Serves the static landing page at /landing (and redirects / -> /landing).
#   * Proxies /landing/api/* to the loopback waitlist intake service.
#   * TAKES DOWN /app: the authenticated ARKOS agent UI + API is NOT exposed.
#     (The ARKOS backend must also be stopped or bound to 127.0.0.1 so its
#      unauthenticated-dangerous endpoints — /tasks, /computer, /v1/chat — are
#      unreachable from the internet. Caddy config alone is not enough.)

ark.mit.edu {
	encode gzip zstd

	# --- security headers (apply to everything) ---
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		X-Frame-Options           "DENY"
		# The page is self-contained (inline <style>/<script>) and loads Google
		# Fonts; the form posts same-origin to /landing/api. Tighten if you
		# externalize assets later.
		Content-Security-Policy   "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# --- waitlist intake (only public path that reaches Postgres) ---
	handle /landing/api/* {
		reverse_proxy 127.0.0.1:8899

		# Optional hard rate limit at the edge. Requires the caddy-ratelimit
		# plugin (github.com/mholt/caddy-ratelimit); the service also limits
		# per-IP as defense in depth. Uncomment if the plugin is built in:
		# rate_limit {
		# 	zone waitlist { key {remote_host} events 5 window 60s }
		# }
	}

	# --- static landing ---
	handle /landing* {
		root * /var/www/ark-landing
		try_files {path} /index.html
		file_server
	}

	# root -> landing
	redir / /landing 302

	# --- /app is DISABLED for public launch ---
	# Was: handle /app* { reverse_proxy 127.0.0.1:1113 }
	# Leaving it commented documents the takedown. Do NOT re-enable without
	# putting auth in front of it — the ARKOS API has no public auth boundary.

	# everything else -> 404 (no accidental proxy to the app)
	handle {
		respond "not found" 404
	}
}
