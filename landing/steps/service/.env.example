# Copy to .env, fill in, chmod 600, own by the service user. NEVER commit .env.
# Use the SESSION POOLER connection string for the waitlist_writer role, not the
# owner/service_role. Format (Supabase → Project settings → Database → Connection):
WAITLIST_DB_URL=postgresql://waitlist_writer:REPLACE_SECRET@aws-0-REGION.pooler.supabase.com:6543/postgres
WAITLIST_ORIGIN=https://ark.mit.edu
WAITLIST_RATE_MAX=5
WAITLIST_RATE_WINDOW=60
