# Copy to .env and fill in. .env is gitignored; never commit a real credential.
# The config loader hard-fails on any UNSET ${VAR} referenced by config.yaml, so
# every var marked REQUIRED must exist even if its value is empty.

# ===========================================
# Database (REQUIRED)
# ===========================================
# Supabase direct connection. Format:
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#
# PERCENT-ENCODE the password. Supabase passwords routinely contain @ % $ * &,
# and a raw @ silently reparses the DSN — everything after it becomes the host.
#   @ -> %40   % -> %25   $ -> %24   * -> %2A   & -> %26   / -> %2F   : -> %3A
# Encode with:  python3 -c 'import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1],safe=""))' 'PASSWORD'
#
# IPv6: db.<ref>.supabase.co resolves AAAA-only on current Supabase projects.
# It works from a normal dev machine, but a default Docker bridge network and
# most CI runners are IPv4-only and will fail with "Network is unreachable".
# From those, use the transaction pooler instead — and note db/pool.py already
# sets statement_cache_size=0, which is exactly what the pooler requires:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_URL=
#
# db/migrate.py ONLY: with no DB_URL and no `database.url` in config.yaml it
# assembles a DSN from POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_HOST,
# POSTGRES_PORT and POSTGRES_DB (defaulting to postgres/postgres/localhost/
# 5432/postgres). Nothing else in the app reads them; set DB_URL instead.

# ===========================================
# Composio / MCP (REQUIRED — may be empty)
# ===========================================
# Every MCP tool reaches its service through ONE Composio MCP server, named in
# config.yaml under `mcp.server_id`. This key is the project credential: it
# authenticates the MCP wire AND Composio's REST API, and combined with the
# `user_id` on the per-user url it is asserted identity for every user of this
# app. It travels as `x-api-key` — a bearer header is refused, and sending both
# is refused as well.
#
# THE MOST SENSITIVE CREDENTIAL ON THE BOX. It is trusted because the harness is
# the sole identity authority; it belongs in .env and nowhere else — never in a
# sandbox, never in the browser, never in a tool result.
COMPOSIO_API_KEY=

# Web search is OURS, not a connector: one app-level SerpAPI key, no per-user
# OAuth, so every user's searches share our quota and nothing about it is
# per-user. Unset, `web_search` reports itself unavailable and nothing else
# breaks.
SERPAPI_API_KEY=

# ===========================================
# LLM (REQUIRED - may be empty)
# ===========================================
# The endpoint itself is `llm.base_url` in config.yaml, not a variable here.
# This is only the key sent to it. Against a local SGLang server the SDK still
# demands a value and the server does not check it, so leaving it empty is
# right: client.py sends "-".
OPENAI_API_KEY=

# ===========================================
# Auth
# ===========================================
# Two secrets, because they are two trust domains. Both REQUIRED and non-empty:
# assert_secure_secrets() refuses to start without them, and there is no demo
# bypass. An earlier design had one secret doing both jobs; these are two.
#
# OPTIONAL on a current project. Supabase signs access tokens with a key
# published at /auth/v1/.well-known/jwks.json, which is fetched automatically
# from the project URL, so nothing needs setting. Fill this in only for a
# project still signing with the legacy shared secret
# (Project Settings -> API -> JWT Secret). We never sign with it.
SUPABASE_JWT_SECRET=
#
# Signs the httpOnly session cookie WE issue, after that token verifies. Any
# random 32+ bytes; rotating it signs everyone out and nothing worse.
#   python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
ARKOS_SESSION_SECRET=

# ===========================================
# Store (REQUIRED, may be empty)
# ===========================================
# The bucket holding the agent's files. Bytes are content-addressed; the tree
# lives in Postgres. The sandbox disk is a cache of this.
#
# OPTIONAL: config.yaml's store.bucket ("arkos") is used when this is unset.
# Create the bucket in the Supabase dashboard (Storage -> New bucket), PRIVATE:
# the secret key below bypasses RLS, and a public bucket would serve every blob
# to anyone who can guess a hash.
STORE_BUCKET=

# Read from the environment rather than config.yaml, so an unset key does not
# crash config load for the parts that do not need it.
#
# SUPABASE_URL is optional: both DSN shapes above carry the project ref, so it
# is derived from DB_URL when unset. Set it only for a non-Supabase Postgres or
# a custom domain.
SUPABASE_URL=
#
# REQUIRED for the store. A secret API key: Settings -> API Keys -> Secret keys
# -> Create (it looks like sb_secret_...). Prefer these over the legacy
# service_role JWT -- each one is revocable and rotatable on its own, where
# rotating service_role invalidates every key in the project at once.
#
# It bypasses RLS, so it is a server-side secret: never in a browser, never in
# a sandbox, and the bucket it reaches must be private.
SUPABASE_SECRET_KEY=
#
# Legacy fallback, read only when SUPABASE_SECRET_KEY is unset. Leave blank on
# a new install.
SUPABASE_SERVICE_KEY=
#
# REQUIRED for sign-in. The PUBLISHABLE key: Settings -> API Keys -> Publishable
# (it looks like sb_publishable_...). GET /auth/config serves it to the browser,
# which is what it is for -- it names the project and authorizes nothing on its
# own. Do not put the secret key here. SUPABASE_ANON_KEY is read as a fallback
# for a project still on the legacy JWT-shaped anon key.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# GOOGLE SIGN-IN NEEDS NOTHING HERE, and that is the point. The OAuth
# client id and secret live in the Supabase dashboard under Authentication ->
# Providers -> Google; we never hold the secret and there is no variable for it.
# What DOES have to be right, and is not code: the Google Cloud OAuth client's
# authorized redirect URI is Supabase's callback
# (https://<project-ref>.supabase.co/auth/v1/callback), not ours, and Supabase's
# URL Configuration must list <origin>/app/ (TRAILING SLASH) in the Redirect
# Allowlist (that exact string is what we ask for). A redirect the allowlist
# does not name is refused by Supabase and comes back as an error on the URL
# fragment.
#
# AUTH EMAIL depends on which Supabase you run.
#
# Hosted project: NOTHING here. Delivery is SMTP configured in the Supabase
# dashboard, and the sign-in templates are pasted there.
#
# Self-hosted: NOTHING here either. Auth email (autoconfirm, sign-up lock,
# SMTP, the mailpit inbox) is configured in supabase/.env, which
# supabase/compose.yaml reads. See supabase/.env.example.

# ===========================================
# Sandbox
# ===========================================
# Read by the e2b SDK directly from the environment, not through config.yaml.
E2B_API_KEY=

# ===========================================
# Browser tool (optional — all have defaults)
# ===========================================
# Steps, budgets and the model live in config.yaml's `browser:` block; the
# browser reads exactly two variables here. BROWSERLESS_URL
# is where the container is: the tool reads `browser.cdp_url` first and falls
# back to this, and with neither set browser_task refuses rather than launching a
# browser on this host. BROWSER_USE_STEALTH=0 stops `stealth=true` being appended
# to the CDP url — worth doing only while debugging, because without it pages
# serve a bot wall. Steps, budgets and the model are config.yaml's; there is no
# domain allowlist, here or anywhere else.
BROWSERLESS_URL=
BROWSER_USE_STEALTH=
