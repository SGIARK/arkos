# Copy to .env and fill in. .env is gitignored; never commit a real credential.
# The config loader hard-fails on any UNSET ${VAR} referenced by config.yaml, so
# every var marked REQUIRED must exist even if its value is empty.

# ===========================================
# Database (REQUIRED)
# ===========================================
# Supabase direct connection. Format:
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#
# PERCENT-ENCODE the password. Supabase passwords routinely contain @ % $ * &,
# and a raw @ silently reparses the DSN — everything after it becomes the host.
#   @ -> %40   % -> %25   $ -> %24   * -> %2A   & -> %26   / -> %2F   : -> %3A
# Encode with:  python3 -c 'import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1],safe=""))' 'PASSWORD'
#
# IPv6: db.<ref>.supabase.co resolves AAAA-only on current Supabase projects.
# It works from a normal dev machine, but a default Docker bridge network and
# most CI runners are IPv4-only and will fail with "Network is unreachable".
# From those, use the transaction pooler instead — and note db/pool.py already
# sets statement_cache_size=0, which is exactly what the pooler requires:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_URL=

# ===========================================
# Smithery / MCP (REQUIRED — may be empty)
# ===========================================
SMITHERY_API_KEY=
SMITHERY_NAMESPACE=arkos-dev

# REQUIRED because config.yaml's slack server injects it as a header.
SLACK_BOT_TOKEN=

# ===========================================
# LLM
# ===========================================
# SGLang serves an OpenAI-compatible endpoint; the SDK demands a key but the
# value is not checked. See model_module/run.sh for the launch flags.
OPENAI_API_KEY=
SGLANG_URL=http://localhost:30000

# ===========================================
# Auth
# ===========================================
# jwt_utils.assert_secure_secret() refuses to start on the built-in default
# unless ARK_DEMO_MODE is set. Both are scheduled for deletion when Task 4
# replaces this with Supabase JWT verification + a session cookie.
ARK_JWT_SECRET=
ARK_DEMO_MODE=

# ===========================================
# Sandbox
# ===========================================
# Read by the e2b SDK directly from the environment, not through config.yaml.
E2B_API_KEY=

# ===========================================
# Browser tool (optional — all have defaults)
# ===========================================
# tool_module/browser_tool.py reads ~15 BROWSER_USE_* overrides; these are the
# ones worth knowing. Task 9 collapses them into a browser: block in config.yaml.
BROWSERLESS_URL=
BROWSER_STREAM_ENABLED=
BROWSER_USE_MAX_STEPS=
BROWSER_USE_MAX_SECONDS=
BROWSER_USE_ALLOWED_DOMAINS=

# ===========================================
# Waitlist (landing page only — NOT this backend)
# ===========================================
# vercel-landing/api/waitlist.js talks to Supabase over PostgREST with an anon
# key, not over DB_URL. Set these in Vercel's env, not here.
#   SUPABASE_URL=https://<project-ref>.supabase.co
#   SUPABASE_WAITLIST_KEY=<anon key>
# Requires waitlist-setup/003_waitlist_anon_insert.sql applied to the project.
